{
    "include":  [
                    "lib/**/*",
                    "bin/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ],
    "compilerOptions":  {
                            "forceConsistentCasingInFileNames":  true,
                            "outDir":  "./dist",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "resolveJsonModule":  true,
                            "declaration":  true,
                            "strict":  true,
                            "target":  "ES2022",
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "module":  "commonjs"
                        }
}
